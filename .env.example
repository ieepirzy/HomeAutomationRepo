# Copy to .env for local testing. In production this repo is deployed via
# Portainer's Git-repository stack feature — set these as the stack's
# Environment Variables in the Portainer UI instead of committing a .env
# file. Portainer injects them the same way a .env file would; nothing here
# needs to touch git. See docs/wakeup-protocol.md "Secrets" section.
#
# Never commit a real .env. It is gitignored.

# --- General ---
TZ=Europe/Helsinki

# --- Mira Home MCP (read-only Home Assistant state adapter) ---
# Separate client credential for http://<host>:8423/mcp. Do not reuse the HA
# token. Generate with: openssl rand -hex 32
MIRA_HOME_MCP_TOKEN=changeme-generate-a-real-random-token

# Companion App tracker or person entity used by get_location(). A device_tracker
# can provide zone, coordinates, accuracy and speed; a person entity usually
# provides the normalized HA zone but may not retain speed.
HA_LOCATION_ENTITY=device_tracker.ilas_iphone

# Optional Companion App sensors. Exact-location mode provides coordinates,
# accuracy and speed on the tracker; Geocoded Location provides the address;
# Activity provides Stationary/Walking/Running/Automotive/Cycling state.
HA_ADDRESS_ENTITY=sensor.ilas_iphone_geocoded_location
HA_ACTIVITY_ENTITY=sensor.ilas_iphone_activity

# Calendar descriptions are never returned; locations are opt-in per tool call.
HA_CALENDAR_ENTITIES=calendar.ila

# get_home_state() exposes only these explicit comma-separated allowlists.
# Fill these with the real entity IDs created by HA integrations. Empty groups
# are returned as unconfigured rather than guessed from names or domains.
HA_OCCUPANCY_ENTITIES=person.ila
HA_ENTRY_ENTITIES=
HA_LIGHT_ENTITIES=
HA_CLIMATE_ENTITIES=
HA_HUMIDITY_ENTITIES=
HA_WEATHER_ENTITIES=weather.forecast_home
HA_MEDIA_ENTITIES=
HA_DESKTOP_ACTIVITY_ENTITIES=
HA_MODE_ENTITIES=input_boolean.sleep_mode
HA_EXTRA_STATE_ENTITIES=

# Optional read-only Gmail and iCloud Mail accounts for search_emails() and
# get_email(). Use provider app passwords, not the primary account passwords.
# Each folder list is an explicit authority boundary. Start with INBOX; add the
# exact provider folder name (for example Gmail's localized All Mail folder or
# iCloud Archive) only after verifying it with the provider contract test.
GMAIL_IMAP_USERNAME=
GMAIL_IMAP_PASSWORD=
GMAIL_IMAP_FOLDERS=INBOX
ICLOUD_IMAP_USERNAME=
ICLOUD_IMAP_PASSWORD=
ICLOUD_IMAP_FOLDERS=INBOX

# Messages larger than this are not body-fetched. Returned visible text is also
# bounded independently. Attachment contents and remote HTML resources are never
# returned by the v1 email tools.
EMAIL_MAX_BODY_BYTES=524288
EMAIL_MAX_BODY_CHARS=20000

# --- Briefing service ---
# High-entropy shared secret between Home Assistant (rest_command) and the
# briefing service. Generate with: openssl rand -hex 32
BRIEFING_AUTH_TOKEN=changeme-generate-a-real-secret

# xAI (Grok) API key — used for both briefing text generation and TTS
# (services/briefing/README.md). Required — the briefing falls back to a
# deterministic template if the API call fails at runtime, but the service
# will not start without a key configured.
XAI_API_KEY=xai-...
# grok-4.3: cheaper, full 1M context. grok-4.5 for quality; grok-4.1-fast
# or grok-build-0.1 for cheapest/lowest-latency.
XAI_MODEL=grok-4.3
XAI_BASE_URL=https://api.x.ai/v1

# TTS provider for the spoken briefing. One of: xai | none
# "none" skips audio generation entirely — the briefing plays as HA TTS
# via whatever HA-native TTS engine you configure instead (see
# docs/wakeup-protocol.md "AI Morning Briefing / TTS" section).
TTS_PROVIDER=xai
XAI_TTS_VOICE_ID=eve
XAI_TTS_LANGUAGE=en

# Weather for the briefing (optional — omitted from the briefing if unset)
OPENWEATHER_API_KEY=
HOME_LAT=61.4991
HOME_LON=23.7871

# Bind port for the briefing service on the host loopback interface only.
BRIEFING_PORT=8420

# --- Wake gateway (services/wake-gateway) ---
# Path-segment bearer secrets for the two Shortcuts-facing GET endpoints.
# Generate with: openssl rand -hex 24
WAKE_TOKEN=changeme-generate-a-real-random-id
UNDOCK_TOKEN=changeme-generate-a-real-random-id

# Home Assistant Long-Lived Access Token, generated via the HA UI
# (Profile > Security > Long-Lived Access Tokens) — see
# services/wake-gateway/README.md. This does NOT exist until after Home
# Assistant has booted at least once, so the deploy order on a fresh
# install is: (1) deploy with a placeholder value here so all three
# containers come up, (2) log into HA and generate the real token,
# (3) update this variable in the Portainer stack env vars and redeploy.
HA_LONG_LIVED_TOKEN=changeme-generate-after-first-boot
HA_BASE_URL=http://127.0.0.1:8123

# --- Home Assistant secrets ---
# HA's own secrets.yaml references (webhook IDs, entity IDs, light
# groups, etc.) are documented in homeassistant/secrets.yaml.example —
# that file lives on the host only, outside this .env, since it's read
# by Home Assistant directly rather than injected as a container env var.
