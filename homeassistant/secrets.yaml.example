# Copy to homeassistant/secrets.yaml on the host and fill in real values.
# NOT in git (see .gitignore) — created once by hand on first deployment
# and left alone by Portainer Git redeploys, since it isn't a file git
# tracks in this repo at all.
#
# Several of these aren't secrets in the security sense — they're
# per-household device identifiers (entity IDs, media players). They live
# here anyway because HA's !secret mechanism is the only built-in way to
# centralize a value that's referenced from multiple places in a package
# file without repeating literal strings. See docs/wakeup-protocol.md
# "Configuration model" for why.

# --- Location (also used by homeassistant: block in configuration.yaml) ---
home_latitude: 61.4991
home_longitude: 23.7871

# --- Wake protocol entity references ---
# One or more light entities that should ramp on at wake. Grouped into
# light.ila_wake_lights by the package. Pick the lights most visible from
# bed. Example after setting up the native WiZ integration:
wake_light_entities:
  - light.bedroom_wiz_1
  - light.bedroom_wiz_2

# Companion App battery-state sensor for the phone charging in the
# kitchen. Find the exact entity_id under Settings > Devices & Services >
# Mobile App > (device) after installing the Home Assistant iOS app.
iphone_battery_state_entity: sensor.ilas_iphone_battery_state

# Where the morning briefing plays. Any media_player entity that can play
# a URL — a smart speaker, or the phone itself via the Companion App's
# media_player entity (announcement support varies by device).
briefing_media_player_entity: media_player.kitchen_speaker

# HA-native TTS engine used ONLY for the short deterministic fallback
# greeting (see docs "AI Morning Briefing" — the main briefing's audio is
# pre-generated by the briefing service, not by HA TTS). Any configured
# tts entity, e.g. cloud, or a local piper installation.
tts_engine_entity: tts.home_assistant_cloud

# --- Webhook IDs (these act as bearer secrets — generate real random
# values, don't reuse the placeholders below) ---
# openssl rand -hex 24
ila_wake_webhook_id: changeme-generate-a-real-random-id
ila_undock_webhook_id: changeme-generate-a-real-random-id
briefing_ready_webhook_id: changeme-generate-a-real-random-id

# --- Briefing service bridge ---
# HA runs on network_mode: host, so the briefing service (bound to
# 127.0.0.1:${BRIEFING_PORT}, default 8420 — see compose.yaml) is reached
# via host loopback.
briefing_generate_url: http://127.0.0.1:8420/generate
# Must be "Bearer <BRIEFING_AUTH_TOKEN>", where BRIEFING_AUTH_TOKEN is the
# same value set in .env / the Portainer stack environment variables.
briefing_auth_header: "Bearer changeme-generate-a-real-secret"
